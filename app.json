{
  "expo": {
    "name": "ScanTrack",
    "slug": "scantrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ScanTrack uses the camera to scan your receipts.",
        "NSPhotoLibraryUsageDescription": "ScanTrack lets you upload receipt photos from your library."
      },
      "bundleIdentifier": "com.scantrack.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1420",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.scantrack.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#F4F6FA",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "ScanTrack uses the camera to scan your receipts.",
          "photosPermission": "ScanTrack lets you upload receipt photos from your library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ScanTrack uses the camera to scan your receipts.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ]
  }
}